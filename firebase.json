{
  "hosting": [
    {
      "target": "admin",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/node_modules/**",
        "**/.DS_Store",
        "**/.gitignore",
        "**/.eslintrc*"
      ],
      "rewrites": [{ "source": "**", "destination": "/index.html" }],
      "headers": [
        {
          "source": "/.well-known/apple-app-site-association",
          "headers": [
            { "key": "Content-Type", "value": "application/json" },
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
          ]
        },
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            },
            {
              "key": "Cross-Origin-Opener-Policy",
              "value": "same-origin-allow-popups"
            }
          ]
        },
        {
          "source": "**/*.@(js|css|woff|woff2|ttf|otf|png|jpg|jpeg|gif|webp|svg|ico)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "//": "BA training assets: the LD field guide is a self-extracting single-file bundle (~4MB) and the video/PDFs are multi-MB. The blanket `**` no-store rule above would re-download all of it on every open, which on store LTE is the difference between instant and unusable. Matched LAST so it wins for these paths only. A week is long enough that a BA re-reading between shifts pays nothing, and short enough that a content fix reaches the field without renaming files — if something urgent changes, ship it under a new filename and update the TrainingResource URL. Scoped to file extensions so the /training/:code SPA shell stays no-store; under no-store the CDN also ignores Range, and iOS Safari will not play <video> without 206 responses.",
          "source": "/training/**/*.@(mp4|mov|m4v|webm|pdf|html|jpg|jpeg|png|webp)",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=604800" }
          ]
        },
        {
          "//": "Check-in service worker must not inherit the immutable JS cache. A stale SW would keep an old shell after a deploy.",
          "source": "/checkin/sw.js",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
            { "key": "Content-Type", "value": "application/javascript" }
          ]
        },
        {
          "source": "/checkin/manifest.webmanifest",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
            { "key": "Content-Type", "value": "application/manifest+json" }
          ]
        }
      ]
    },
    {
      "target": "spark",
      "public": "hosting/spark-redirect",
      "ignore": [
        "firebase.json",
        "**/node_modules/**",
        "**/.DS_Store",
        "**/.gitignore",
        "**/.eslintrc*"
      ],
      "redirects": [
        {
          "source": "/",
          "destination": "https://client.igniteproductions.co/",
          "type": 301
        },
        {
          "source": "/:path*",
          "destination": "https://client.igniteproductions.co/:path",
          "type": 301
        }
      ]
    },
    {
      "target": "client",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/node_modules/**",
        "**/.DS_Store",
        "**/.gitignore",
        "**/.eslintrc*"
      ],
      "rewrites": [{ "source": "**", "destination": "/index.html" }],
      "headers": [
        {
          "source": "/.well-known/apple-app-site-association",
          "headers": [
            { "key": "Content-Type", "value": "application/json" },
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
          ]
        },
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            },
            {
              "key": "Cross-Origin-Opener-Policy",
              "value": "same-origin-allow-popups"
            }
          ]
        },
        {
          "source": "**/*.@(js|css|woff|woff2|ttf|otf|png|jpg|jpeg|gif|webp|svg|ico)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "//": "Client serves BA training pages. Under the blanket no-store rule the CDN ignores Range and answers 200 with the whole file; iOS Safari will not play <video> without 206 partial responses. Scoped to file extensions so the /training/:code SPA shell stays no-store.",
          "source": "/training/**/*.@(mp4|mov|m4v|webm|pdf|html|jpg|jpeg|png|webp)",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=604800" }
          ]
        },
        {
          "source": "/training/**",
          "headers": [
            { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
          ]
        },
        {
          "source": "/checkin/sw.js",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
            { "key": "Content-Type", "value": "application/javascript" }
          ]
        },
        {
          "source": "/checkin/manifest.webmanifest",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
            { "key": "Content-Type", "value": "application/manifest+json" }
          ]
        }
      ]
    }
  ]
}
